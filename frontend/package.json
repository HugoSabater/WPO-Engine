{
  "name": "wpo-engine-desktop",
  "private": true,
  "version": "2.0.0",
  "description": "WPO Analytics Engine — WordPress & WooCommerce Performance Monitor",
  "author": "floressolidarias.org",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON=true vite",
    "electron:build": "tsc && ELECTRON=true vite build && electron-builder",
    "electron:preview": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "make:win": "cross-env ELECTRON=true CSC_IDENTITY_AUTO_DISCOVERY=false vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "build": {
    "appId": "com.floressolidarias.wpoengine",
    "productName": "WPO Engine",
    "directories": {
      "output": "C:\\WPO-Build\\release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "electron": "^36.2.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "lighthouse": "^13.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "sqlite3": "^6.0.1"
  }
}
